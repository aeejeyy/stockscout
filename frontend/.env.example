# StockScout frontend environment variables
#
# DEMO MODE: leave the Supabase values empty (or set NEXT_PUBLIC_DEMO_MODE=true)
# and the app runs entirely on built-in sample data, with no login, database or
# backend required. The demo API lives in src/lib/demo and is served from /api.

# Force demo mode even when Supabase is configured
NEXT_PUBLIC_DEMO_MODE=

# Supabase (public anon key, not the service_role key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# FastAPI backend (e.g. your Railway URL) and the shared secret it expects
# (same value as API_SECRET_KEY on the backend)
FASTAPI_URL=
FASTAPI_SECRET=
